# Template for electron/.env (which is gitignored).
#
# Setup:
#   1. Copy this file to .env in the same directory (electron/.env).
#   2. Fill in values from GCP Console → APIs & Services → Credentials
#      → click your "iDEP Desktop" OAuth client.
#   3. electron/.env is gitignored and will not be committed.
#
# For CI builds: write electron/.env from GitHub Actions secrets
# before running `npm run dist`. Example workflow snippet:
#
#   - run: |
#       cat > electron/.env <<EOF
#       GOOGLE_OAUTH_CLIENT_ID=${{ secrets.GOOGLE_OAUTH_CLIENT_ID }}
#       GOOGLE_OAUTH_CLIENT_SECRET=${{ secrets.GOOGLE_OAUTH_CLIENT_SECRET }}
#       ENTITLEMENT_URL=https://entitlement-auzgq7lgsq-uc.a.run.app
#       CHECKOUT_URL=${{ secrets.CHECKOUT_URL }}
#       PORTAL_URL=${{ secrets.PORTAL_URL }}
#       EOF

GOOGLE_OAUTH_CLIENT_ID=<paste-your-client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<paste-your-client-secret>
ENTITLEMENT_URL=https://entitlement-auzgq7lgsq-uc.a.run.app
# URL of the createCheckoutSession Cloud Function — from `firebase deploy`
# output or `firebase functions:list`. Powers the "Upgrade to Pro" button.
CHECKOUT_URL=<paste-your-createCheckoutSession-url>
# URL of the createPortalSession Cloud Function. Powers "Manage Subscription"
# (the Customer Portal) for existing subscribers.
PORTAL_URL=<paste-your-createPortalSession-url>

# Where the "Update" button (shown when a free user is below the minimum
# version) sends users to download the latest build. Optional — falls back to
# the GitHub releases page if unset.
RELEASES_PAGE=https://github.com/dan-burk/idepGolem/releases/latest
